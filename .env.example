# Default: entirely local, clearly labelled demo with synthetic data.
APP_MODE=demo
PORT=8787
HOST=127.0.0.1
DATA_DIR=.data
WEB_ORIGIN=http://127.0.0.1:5173
WEB_APP_URL=http://127.0.0.1:5173/
VITE_APP_MODE=demo
VITE_API_URL=/api
VITE_BASE_PATH=/

# Live local use: set both modes to local and matching random access tokens.
# The local token is ONLY for a loopback development server. Never use it in a Pages build.
LOCAL_ACCESS_TOKEN=
VITE_LOCAL_ACCESS_TOKEN=

# Cloud deployment uses cloud mode, Firebase identity and the allowed owner UID.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=australia-southeast1
OWNER_UID=
WORKER_URL=
WORKER_SERVICE_ACCOUNT=
MAINTENANCE_TOKEN=
QUEUE_NAME=steadier-jobs
STORAGE_BUCKET=
TEMP_BUCKET=
BACKUP_BUCKET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/google/callback
# 32 bytes encoded as base64. Generate with node crypto.randomBytes(32).
ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=
# Enable only after checking your subscription permits retained source data/derived audio.
NEWS_STORAGE_RIGHTS_CONFIRMED=false
FFMPEG_PATH=ffmpeg
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
