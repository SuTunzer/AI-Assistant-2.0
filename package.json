{
  "name": "steadier-second-brain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "build:web": "tsc -p tsconfig.web.json --noEmit && vite build",
    "check": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/apps/api/src/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/icons.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:cloud": "node scripts/prepare-cloud.mjs",
    "format": "prettier --write apps packages tests scripts *.ts",
    "format:check": "prettier --check apps packages tests scripts *.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@google-cloud/secret-manager": "^6.1.0",
    "@google-cloud/storage": "^7.16.0",
    "@google-cloud/tasks": "^6.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
